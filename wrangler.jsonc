{
  "$schema": "node_modules/wrangler/config-schema.json",
  // developer.audiencekit.com: a Worker that only serves the static Astro build in dist/ (no code of its own).
  "name": "developer-audiencekit-com",
  "compatibility_date": "2026-11-24",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  // A Workers custom domain: deploying creates the proxied DNS record in the audiencekit.com zone and its edge
  // certificate, so nothing has to be set up by hand in DNS.
  "routes": [
    { "pattern": "developer.audiencekit.com", "custom_domain": true }
  ],
  // Branch builds run `wrangler preview`, and Worker Previews don't inherit top-level settings unless a `previews`
  // block exists. This Worker only serves static assets, so an empty block is enough.
  "previews": {}
}
